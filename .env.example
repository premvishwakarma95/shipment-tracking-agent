# --- Core ---

# MongoDB connection string. Only CallRequest/RawCapture live here — this is
# a thin correlation store, not a system of record, so a local/dev Mongo
# instance is fine for most work.
MONGODB_URI=mongodb://localhost:27017/mdr-agent-three

# Port the Express server listens on.
PORT=3000

# Publicly reachable base URL for THIS service (via ngrok in dev, your real
# domain in prod). Used to build the Vapi tool-webhook URL and the recordings
# proxy links handed back to MDR. Vapi cannot reach localhost directly.
PUBLIC_BASE_URL=http://localhost:3000

# --- Vapi (voice) ---

VAPI_API_KEY=
# Set after running `npm run assistant:create` for the first time — the
# script prints the created assistant id, paste it here for future
# create.ts runs to PATCH the same assistant instead of creating a new one.
VAPI_ASSISTANT_ID=
# The Vapi phone number (BYO or Vapi-hosted) calls are placed from.
VAPI_PHONE_NUMBER_ID=

# Shared secret appended as a query param on recordings proxy links
# (?key=...). Query param, not a header, deliberately — this URL needs to
# work as a bare clickable link / <audio src> for whoever MDR hands it to,
# which can't attach custom headers.
RECORDINGS_PROXY_SECRET=

# --- Inbound: MDR -> Voice API ---

# Required x-api-key header value MDR must send on POST /mdr/call-requests.
# Rotate this, don't remove the check, if it ever leaks in a log.
MDR_WEBHOOK_SHARED_SECRET=

# --- Outbound: Voice API -> MDR (src/mdr/*) ---
# PLACEHOLDER as of 2026-09: MDR has not yet shared their real API details.
# See docs/requirements-tracker.md. Update these three once confirmed —
# no other file should need to change.

MDR_API_BASE_URL=https://placeholder.mdr.example.com
# Auth scheme (Bearer token vs custom header vs API key query param) is also
# unconfirmed — src/mdr/client.ts currently assumes a Bearer token.
MDR_API_AUTH_TOKEN=
